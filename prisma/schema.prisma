datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  passwordHash  String
  role          String          @default("STUDENT") // STUDENT | ADMIN
  goal          String?         @default("Software Engineering Internship")
  avatar        String?         @default("/student-avatar.png")
  skillLevel    String?         @default("Intermediate")
  learningStyle String?         @default("Hands-on Practice")
  weeklyTime    String?         @default("8–12 Hours")
  bio           String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  quizAttempts   QuizAttempt[]
  reviews        CourseReview[]
  bookmarks      Bookmark[]
  studyTasks     StudyTask[]
  notifications  Notification[]
}

model Course {
  id            String          @id
  title         String
  instructor    String
  category      String
  difficulty    String
  duration      String
  rating        Float           @default(4.8)
  students      Int             @default(0)
  lessons       Int             @default(0)
  match         Int             @default(90)
  description   String
  gradient      String          @default("from-indigo-500 to-violet-600")
  tags          String          @default("[]") // JSON string array
  published     Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  modules       Module[]
  lessonsList   Lesson[]
  enrollments   Enrollment[]
  reviews       CourseReview[]
  bookmarks     Bookmark[]
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  order     Int      @default(0)
  duration  String   @default("2h")

  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
}

model Lesson {
  id        String   @id @default(cuid())
  moduleId  String
  courseId  String
  title     String
  duration  String
  videoUrl  String?
  content   String
  order     Int      @default(0)

  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress  LessonProgress[]
}

model Enrollment {
  id             String    @id @default(cuid())
  userId         String
  courseId       String
  progress       Int       @default(0)
  status         String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  enrolledAt     DateTime  @default(now())
  lastAccessedAt DateTime  @default(now())
  completedAt    DateTime?

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  courseId    String
  completed   Boolean  @default(true)
  completedAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Quiz {
  id           String         @id @default(cuid())
  title        String
  description  String?
  topic        String
  passingScore Int            @default(70)
  createdAt    DateTime       @default(now())

  questions    QuizQuestion[]
  attempts     QuizAttempt[]
}

model QuizQuestion {
  id          String   @id @default(cuid())
  quizId      String
  topic       String
  question    String
  options     String   // JSON array string: ["A", "B", "C", "D"]
  answer      Int      // 0, 1, 2, 3
  explanation String?

  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id             String   @id @default(cuid())
  userId         String
  quizId         String
  score          Int
  totalQuestions Int
  percentage     Int
  passed         Boolean
  answers        String   // JSON object string of selected answers
  topicScores    String?  // JSON topic breakdown
  feedback       String?
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model CourseReview {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int
  comment   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model StudyTask {
  id        String   @id @default(cuid())
  userId    String
  day       String   // "Monday", "Tuesday", etc.
  title     String
  duration  String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // info, success, milestone, alert
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}
