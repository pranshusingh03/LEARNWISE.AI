# Environment variables for LearnWise Full-Stack Platform

# Persistent Database URL
# Local SQLite default:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example (Neon, Supabase, AWS RDS):
# DATABASE_URL="postgresql://user:password@ep-sample-123.region.aws.neon.tech/learnwise?sslmode=require"

# JWT secret for authentication token signing (minimum 32 characters in production)
JWT_SECRET="replace-with-a-secure-random-secret-for-production"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional External Integrations
# RESEND_API_KEY="re_..."
# OPENAI_API_KEY="sk-..."
